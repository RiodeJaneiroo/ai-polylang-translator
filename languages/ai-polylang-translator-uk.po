msgid "AI Translation"
msgstr "AI-переклад"

#: includes/class-aipt-metabox.php:43
msgid "A translation already exists. Its current content will be replaced. Continue?"
msgstr "Переклад уже існує. Поточний вміст перекладу буде замінено. Продовжити?"

#: includes/class-aipt-metabox.php:44
msgid "Preparing…"
msgstr "Підготовка…"

#. translators: %1$d: current block number, %2$d: total number of blocks
#: includes/class-aipt-metabox.php:46
#, php-format
msgid "Translating… block %1$d of %2$d"
msgstr "Переклад… блок %1$d з %2$d"

#: includes/class-aipt-metabox.php:47
msgid "Saving translation…"
msgstr "Збереження перекладу…"

#: includes/class-aipt-metabox.php:48
msgid "Done:"
msgstr "Готово:"

#: includes/class-aipt-metabox.php:49 includes/class-aipt-metabox.php:91
msgid "Open translation"
msgstr "Відкрити переклад"

#: includes/class-aipt-metabox.php:50
msgid "Retry"
msgstr "Повторити"

#: includes/class-aipt-metabox.php:51
msgid "Error:"
msgstr "Помилка:"

#: includes/class-aipt-metabox.php:58
msgid "Save the post first."
msgstr "Спершу збережіть запис."

#. translators: %s: settings page URL
#: includes/class-aipt-metabox.php:65
#, php-format
msgid "Enter an API key on the <a href=\"%s\">settings page</a>."
msgstr "Вкажіть API-ключ на <a href=\"%s\">сторінці налаштувань</a>."

#: includes/class-aipt-metabox.php:94
msgid "Filled fields are kept. New flexible content sections are added and translated, existing sections are kept; repeater blocks with a different number of rows are replaced in full."
msgstr "Заповнені поля зберігаються. Нові секції flexible content додаються та перекладаються, наявні секції зберігаються; блоки repeater з іншою кількістю рядків замінюються повністю."

#: includes/class-aipt-metabox.php:96
msgid "Safe translation"
msgstr "Безпечний переклад"

#: includes/class-aipt-metabox.php:99
msgid "Update translation"
msgstr "Оновити переклад"

#. translators: %s: language name
#: includes/class-aipt-metabox.php:103
#, php-format
msgid "Translate into %s"
msgstr "Перекласти на %s"

#: includes/class-aipt-metabox.php:126 includes/class-aipt-metabox.php:297
msgid "Translation job not found or expired. Start over."
msgstr "Завдання перекладу не знайдено або застаріло. Почніть заново."

#: includes/class-aipt-pipeline.php
msgid "This post type is not enabled in the translation settings."
msgstr "Цей тип запису не ввімкнено в налаштуваннях перекладу."

#: includes/class-aipt-pipeline.php
msgid "API key is not set."
msgstr "API-ключ не задано."

#: includes/class-aipt-pipeline.php
msgid "Invalid target language."
msgstr "Некоректна цільова мова."

#: includes/class-aipt-pipeline.php
msgid "Insufficient permissions to modify the existing translation."
msgstr "Недостатньо прав для зміни наявного перекладу."

#: includes/class-aipt-pipeline.php
msgid "Insufficient permissions to create a translation."
msgstr "Недостатньо прав для створення перекладу."

#: includes/class-aipt-pipeline.php
msgid "A translation already exists — overwrite confirmation is required."
msgstr "Переклад уже існує — потрібне підтвердження перезапису."

#: includes/class-aipt-pipeline.php
msgid "The post has no text to translate."
msgstr "У записі немає тексту для перекладу."

#: includes/class-aipt-pipeline.php
msgid "Could not save the translation job — the payload is too large. Contact an administrator."
msgstr "Не вдалося зберегти завдання перекладу — занадто великий обсяг даних. Зверніться до адміністратора."

#: includes/class-aipt-pipeline.php
msgid "Unknown translation block."
msgstr "Невідомий блок перекладу."

#: includes/class-aipt-pipeline.php
msgid "Could not save the translation result — the payload is too large. Contact an administrator."
msgstr "Не вдалося зберегти результат перекладу — занадто великий обсяг даних. Зверніться до адміністратора."

#: includes/class-aipt-pipeline.php
msgid "Not all blocks are translated — finalization is not possible."
msgstr "Не всі блоки перекладено — завершення неможливе."

#: includes/class-aipt-pipeline.php
msgid "The translation is already being saved. Try again in a few seconds."
msgstr "Переклад уже зберігається. Повторіть запит за кілька секунд."

#: includes/class-aipt-pipeline.php
msgid "The saved translation was not found. Start the translation over."
msgstr "Збережений переклад не знайдено. Почніть переклад заново."

#: includes/class-aipt-writer.php:18
msgid "Source post not found."
msgstr "Вихідний запис не знайдено."

#: includes/class-aipt-writer.php:28
msgid "A translation into this language was created after the job was prepared. Please start the translation again."
msgstr "Переклад цією мовою з'явився вже після підготовки. Почніть переклад заново."

#: includes/class-aipt-writer.php:31
msgid "The prepared translation post was deleted. Please start the translation again."
msgstr "Підготовлений переклад було видалено. Почніть переклад заново."

#: includes/class-aipt-writer.php:35
msgid "You do not have permission to edit the existing translation."
msgstr "Недостатньо прав для зміни наявного перекладу."

#: includes/class-aipt-writer.php:40
msgid "You do not have permission to create a translation."
msgstr "Недостатньо прав для створення перекладу."

#: includes/class-aipt-writer.php:78
msgid "Translation is incomplete — some text parts are missing."
msgstr "Переклад не завершено — відсутні частини тексту."

#: includes/class-aipt-settings.php
msgid "Which model to choose?"
msgstr "Яку модель обрати?"

#: includes/class-aipt-settings.php
msgid "Best for"
msgstr "Для чого підходить"

#: includes/class-aipt-settings.php
msgid "Price per article"
msgstr "Ціна за статтю"

#: includes/class-aipt-settings.php
msgid "Recommended default: the best quality for the money, fast and very cheap."
msgstr "Рекомендована за замовчуванням: найкраща якість за свої гроші, швидка й дуже дешева."

#: includes/class-aipt-settings.php
msgid "Natural, idiomatic phrasing from another provider (Google) — a good backup if OpenAI is unavailable."
msgstr "Природні, живі формулювання від іншого провайдера (Google) — добрий запасний варіант, якщо OpenAI недоступний."

#: includes/class-aipt-settings.php
msgid "The most natural and precise translations — for important pages such as marketing and legal texts."
msgstr "Найприродніші та найточніші переклади — для важливих сторінок, як-от маркетингові та юридичні тексти."

#: includes/class-aipt-settings.php
msgid "Prices are approximate, for a typical article of about 3,000 characters. Longer pages cost proportionally more; the exact amount for every translation is shown in the cost log above."
msgstr "Ціни орієнтовні, з розрахунку типової статті близько 3 000 знаків. Довші сторінки коштують пропорційно дорожче; точна сума кожного перекладу відображається в журналі витрат вище."

#: includes/class-aipt-pipeline.php
msgid "This translation is being written by a WP-CLI bulk translation right now. Try again in a few minutes."
msgstr "Цей переклад зараз записує масовий переклад через WP-CLI. Повторіть спробу за кілька хвилин."

#. translators: 1: translation post ID, 2: error message
#: includes/class-aipt-writer.php
#, php-format
msgid "Translation #%1$d was saved as a draft, but its status or slug could not be updated: %2$s"
msgstr "Переклад #%1$d збережено як чернетку, але не вдалося оновити його статус або ярлик: %2$s"

#. translators: %s: taxonomy name, e.g. "Categories"
#: includes/class-aipt-terms.php
#, php-format
msgid "Terms: %s"
msgstr "Терміни: %s"

#: includes/class-aipt-pipeline.php
msgid "This translation is being created automatically right now. Try again in a few minutes."
msgstr "Цей переклад зараз створюється автоматично. Повторіть спробу за кілька хвилин."

#: includes/class-aipt-settings-auto.php
msgid "Automatic translation"
msgstr "Автоматичний переклад"

#: includes/class-aipt-settings-auto.php
msgid "On publish"
msgstr "Під час публікації"

#: includes/class-aipt-settings-auto.php
msgid "Translate automatically on publish"
msgstr "Автоматично перекладати під час публікації"

#: includes/class-aipt-settings-auto.php
msgid "New posts of the enabled post types in the default language are translated in the background (WP-Cron) into the selected languages and published with the source date. Later edits of the source are not re-translated — use “Update translation” in the AI Translation box of the post."
msgstr "Нові записи увімкнених типів мовою за замовчуванням перекладаються у фоні (WP-Cron) вибраними мовами й публікуються з датою оригіналу. Подальші правки оригіналу повторно не перекладаються — використовуйте «Оновити переклад» у блоці «AI-переклад» запису."

#: includes/class-aipt-settings-auto.php
msgid "Languages"
msgstr "Мови"

#: includes/class-aipt-pipeline.php
msgid "The translation already exists."
msgstr "Переклад уже існує."

#: ai-polylang-translator.php
msgid "AI Translator for Polylang & WPML requires the Polylang or WPML plugin to be active."
msgstr "AI Translator for Polylang & WPML: для роботи плагіна потрібен активний Polylang або WPML."

#: ai-polylang-translator.php
msgid "Polylang and WPML are both active; AI Translator cannot translate until one of them is deactivated."
msgstr "Активні і Polylang, і WPML: AI Перекладач не може перекладати, доки один із них не буде деактивовано."

#. translators: %s: multilingual plugin name, e.g. Polylang
#: includes/class-aipt-settings.php
msgid "AI Translator (%s)"
msgstr "AI Перекладач (%s)"

#: includes/class-aipt-settings.php
msgid "Status"
msgstr "Статус"

#: includes/class-aipt-settings.php
msgid "Enable AI Translator"
msgstr "Увімкнути AI Перекладач"

#: includes/class-aipt-settings.php
msgid "Turn off to park the plugin while another translation tool is used: the AI Translation box, automatic translation and the WP-CLI commands stop working; these settings and the cost log stay available. Turning it back on needs no other changes."
msgstr "Вимкніть, щоб призупинити плагін, поки використовується інший інструмент перекладу: блок «AI-переклад», автоматичний переклад і команди WP-CLI перестають працювати; ці налаштування та журнал витрат залишаються доступними. Для повторного ввімкнення більше нічого змінювати не потрібно."

#. translators: %s: multilingual plugin name, e.g. Polylang
#: includes/class-aipt-metabox.php
msgid "Set the post language (%s) and save the post first."
msgstr "Спершу задайте мову запису (%s) і збережіть його."

#: includes/class-aipt-metabox.php
msgid "AI Translator is disabled in Settings."
msgstr "AI Перекладач вимкнено в налаштуваннях."

#. translators: %s: multilingual plugin name, e.g. Polylang
#: includes/class-aipt-job-builder.php
msgid "The post has no language set in %s."
msgstr "У запису не задано мову в %s."

#. translators: %s: multilingual plugin name, e.g. WPML
#: includes/class-aipt-record.php
msgid "A translation of this post is already in progress in %s."
msgstr "Переклад цього запису вже виконується в %s."

#. translators: %s: multilingual plugin name, e.g. Polylang
#: includes/class-aipt-pipeline.php
msgid "This translation job was not prepared with %s. Start the translation again."
msgstr "Це завдання перекладу було підготовлено не з %s. Запустіть переклад заново."

#: includes/class-aipt-writer.php
msgid "The translation into this language changed after the job was prepared. Please start the translation again."
msgstr "Переклад цією мовою змінився після підготовки завдання. Запустіть переклад заново."

#. translators: 1: translation post ID, 2: error message
#: includes/class-aipt-writer.php
msgid "Translation post #%1$d was updated but could not be linked: %2$s"
msgstr "Запис перекладу #%1$d оновлено, але його не вдалося пов’язати: %2$s"

#. translators: 1: translation post ID, 2: error message
#: includes/class-aipt-writer.php
msgid "Translation post #%1$d was created but could not be linked: %2$s"
msgstr "Запис перекладу #%1$d створено, але його не вдалося пов’язати: %2$s"

#. translators: 1: translation post ID, 2: error message
#: includes/class-aipt-writer.php
#, php-format
msgid "Translation post #%1$d was created and linked, but the final step failed: %2$s"
msgstr "Запис перекладу #%1$d створено й пов’язано, але останній крок не вдався: %2$s"

#. translators: 1: multilingual plugin name, e.g. Polylang, 2: error message
#: includes/class-aipt-writer.php
msgid "The translation could not be linked by %1$s and the created post was removed: %2$s"
msgstr "%1$s не вдалося пов’язати переклад, створений запис видалено: %2$s"

#. translators: 1: translation post ID, 2: source post ID, 3: language code
#: includes/lang/class-aipt-lang-polylang.php
msgid "Polylang did not link post #%1$d as the %3$s translation of post #%2$d."
msgstr "Polylang не пов’язав запис #%1$d як переклад (%3$s) запису #%2$d."

#. translators: 1: translation term ID, 2: source term ID, 3: language code
#: includes/lang/class-aipt-lang-polylang.php
msgid "Polylang did not link term #%1$d as the %3$s translation of term #%2$d."
msgstr "Polylang не пов’язав термін #%1$d як переклад (%3$s) терміна #%2$d."

#: includes/class-aipt-settings-advanced.php
msgid "Extra meta keys to translate"
msgstr "Додаткові мета-ключі для перекладу"

#. translators: %s: example meta key
#: includes/class-aipt-settings-advanced.php
msgid "Custom fields with plain text to translate, one meta key per line (e.g. %s). Only text values are translated; Yoast SEO fields are handled separately."
msgstr "Користувацькі поля зі звичайним текстом для перекладу, по одному мета-ключу в рядку (наприклад, %s). Перекладаються лише текстові значення; поля Yoast SEO обробляються окремо."

#: includes/lang/class-aipt-lang-wpml.php
msgid "WPML's save handler could not be suspended, so WPML may have assigned the translation to the wrong language. The translation was not linked."
msgstr "Не вдалося призупинити обробник збереження WPML, тому WPML міг призначити перекладу неправильну мову. Переклад не пов’язано."

#: includes/lang/class-aipt-lang-wpml.php
msgid "the source post has no WPML language or is already in the target language"
msgstr "вихідний запис не має мови WPML або вже має цільову мову"

#: includes/lang/class-aipt-lang-wpml.php
msgid "the post does not resolve as the translation after linking"
msgstr "після зв’язування запис не визначається як переклад"

#: includes/lang/class-aipt-lang-wpml.php
msgid "the link did not survive the WPML/WCML sync"
msgstr "зв’язок не зберігся після синхронізації WPML/WCML"

#. translators: %d: post ID
#: includes/lang/class-aipt-lang-wpml.php
msgid "post #%d is already the translation in this language"
msgstr "запис #%d уже є перекладом цією мовою"

#: includes/lang/class-aipt-lang-wpml.php
msgid "WPML has translation work in progress for this language"
msgstr "у WPML уже триває робота над перекладом цією мовою"

#: includes/lang/class-aipt-lang-wpml.php
msgid "WPML started translation work for this language while the translation was being written; its WPML translation status was not changed."
msgstr "Під час запису перекладу у WPML почалася робота над перекладом цією мовою; статус перекладу у WPML не змінено."

#: includes/lang/class-aipt-lang-wpml.php
msgid "the post already belongs to a translation group"
msgstr "запис уже входить до групи перекладів"

#. translators: 1: translation post ID, 2: language code, 3: reason
#: includes/lang/class-aipt-lang-wpml.php
msgid "WPML did not link post #%1$d as the %2$s translation: %3$s."
msgstr "WPML не пов’язав запис #%1$d як переклад (%2$s): %3$s."

#. translators: 1: translation term ID, 2: source term ID, 3: language code
#: includes/lang/class-aipt-lang-wpml.php
msgid "WPML did not link term #%1$d as the %3$s translation of term #%2$d."
msgstr "WPML не пов’язав термін #%1$d як переклад (%3$s) терміна #%2$d."

#. translators: %s: comma-separated WPML API names
#: includes/lang/class-aipt-lang-wpml-tm.php
msgid "AI Translator cannot write with this WPML version: %s not available."
msgstr "AI Перекладач не може записувати з цією версією WPML: недоступно %s."

#. translators: %s: hook name
#: includes/lang/class-aipt-lang-wpml-tm.php
msgid "WooCommerce Multilingual is active but its product sync (%s) is not available."
msgstr "WooCommerce Multilingual активний, але його синхронізація товарів (%s) недоступна."

#: includes/class-aipt-settings-advanced.php
msgid "WPML translation editor"
msgstr "Редактор перекладів WPML"

#: includes/class-aipt-settings-advanced.php
msgid "Use the WordPress editor for translations written by AI Translator"
msgstr "Використовувати редактор WordPress для перекладів, створених AI Перекладачем"

#: includes/class-aipt-settings-advanced.php
msgid "When the first AI translation of a post is written, the original post is switched to WPML's native-editor mode, so opening the translation in wp-admin does not redirect to WPML's translation editor."
msgstr "Коли записується перший AI-переклад запису, оригінал перемикається в режим вбудованого редактора WPML, щоб під час відкриття перекладу в адмінці не відбувалося перенаправлення до редактора перекладів WPML."

#: includes/lang/class-aipt-lang-wpml-sync.php
msgid "WPML's save handler could not be suspended; nothing was written."
msgstr "Не вдалося призупинити обробник збереження WPML; нічого не записано."

#. translators: 1: translation post ID, 2: number of content parts
#: includes/class-aipt-blocks.php
#, php-format
msgid "Translation #%1$d was saved, but some content parts (%2$d) kept the original text because their block markup could not be protected or came back changed. Translate the post again or edit those parts manually."
msgstr "Переклад #%1$d збережено, але частина вмісту (%2$d фрагм.) залишилася мовою оригіналу, бо розмітку блоків не вдалося захистити або вона повернулася зміненою. Перекладіть запис заново або виправте ці фрагменти вручну."

#. translators: 1: translation post ID, 2: number of content parts
#: includes/class-aipt-blocks.php
#, php-format
msgid "Translation #%1$d was saved and left as a draft: some content parts (%2$d) kept the original text because their block markup could not be protected or came back changed. Translate the post again or edit those parts manually."
msgstr "Переклад #%1$d збережено й залишено чернеткою: частина вмісту (%2$d фрагм.) залишилася мовою оригіналу, бо розмітку блоків не вдалося захистити або вона повернулася зміненою. Перекладіть запис заново або виправте ці фрагменти вручну."
