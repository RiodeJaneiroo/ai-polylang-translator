msgid "The model returned invalid JSON."
msgstr "Модель повернула невалідний JSON."

#: includes/class-aipt-gateway.php:118
msgid "API key is not set. Enter it on the settings page."
msgstr "API-ключ не задано. Вкажіть його в налаштуваннях."

#: includes/class-aipt-gateway.php:164
#, php-format
msgid "Connection error with AI Gateway: %s"
msgstr "Помилка з'єднання з AI Gateway: %s"

#: includes/class-aipt-gateway.php:172
#, php-format
msgid "AI Gateway returned error %1$d: %2$s"
msgstr "AI Gateway повернув помилку %1$d: %2$s"

#: includes/class-aipt-gateway.php:179
msgid "AI Gateway returned a malformed response."
msgstr "AI Gateway повернув некоректну відповідь."

#: includes/class-aipt-gateway.php:190
msgid "The model response was cut off by the token limit — try another model or reduce the amount of text."
msgstr "Відповідь моделі обрізано через ліміт токенів — спробуйте іншу модель або зменшіть обсяг тексту."

#: includes/class-aipt-gateway.php:193
msgid "The model rejected the response because of a safety filter."
msgstr "Модель відхилила відповідь через фільтр безпеки."

#: includes/class-aipt-gateway.php:199
msgid "The model finished the request without a text response."
msgstr "Модель завершила запит без текстової відповіді."

