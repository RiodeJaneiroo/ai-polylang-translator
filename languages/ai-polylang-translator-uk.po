#. Plugin Name of the plugin
#: ai-polylang-translator.php
msgid "AI Translator for Polylang & WPML"
msgstr "AI Translator for Polylang & WPML"

#. Description of the plugin
#: ai-polylang-translator.php
msgid ""
"AI translation of posts, WooCommerce products, terms and ACF fields into "
"other Polylang or WPML languages via Vercel AI Gateway."
msgstr ""
"Переклад записів, товарів WooCommerce, термінів і полів ACF іншими мовами "
"Polylang або WPML через Vercel AI Gateway."

#. Author of the plugin
#: ai-polylang-translator.php
msgid "Vadym Zm"
msgstr ""

#. Author URI of the plugin
#: ai-polylang-translator.php
msgid "https://artzm.dev/"
msgstr ""

#: ai-polylang-translator.php:60
msgid ""
"AI Translator for Polylang & WPML requires the Polylang or WPML plugin to be "
"active."
msgstr ""
"AI Translator for Polylang & WPML: для роботи плагіна потрібен активний "
"Polylang або WPML."

#: ai-polylang-translator.php:102
msgid ""
"Polylang and WPML are both active; AI Translator cannot translate until one "
"of them is deactivated."
msgstr ""
"Активні і Polylang, і WPML: AI Перекладач не може перекладати, доки один із "
"них не буде деактивовано."

#: includes/class-aipt-acf-schema.php:181
msgid "No ACF field groups found."
msgstr "Групи полів ACF не знайдено."

#: includes/class-aipt-acf-schema.php:199 includes/class-aipt-bulk-page.php:333
msgid "Translate"
msgstr "Перекласти"

#: includes/class-aipt-acf-schema.php:201
msgid "Copy"
msgstr "Копіювати"

#: includes/class-aipt-acf-schema.php:203
msgid "Don't touch"
msgstr "Не чіпати"

#: includes/class-aipt-acf-schema.php:213
msgid "Copied without translation"
msgstr "Копіюється без перекладу"

#: includes/class-aipt-auto-run.php:31
msgid "The post is not published."
msgstr "Запис не опубліковано."

#: includes/class-aipt-auto-run.php:35
msgid "The post is no longer in the default language."
msgstr "Запис більше не мовою за замовчуванням."

#: includes/class-aipt-auto-run.php:39 includes/class-aipt-auto.php:199
msgid "Automatic translation is turned off in Settings."
msgstr "Автоматичний переклад вимкнено в налаштуваннях."

#: includes/class-aipt-auto-run.php:43 includes/class-aipt-gateway.php:164
msgid "API key is not set. Enter it on the settings page."
msgstr "API-ключ не задано. Вкажіть його в налаштуваннях."

#. translators: %d: user ID
#: includes/class-aipt-auto-run.php:54
#, php-format
msgid "User #%d cannot edit the post."
msgstr "Користувач #%d не може редагувати запис."

#. translators: %s: language code
#: includes/class-aipt-auto-run.php:77
#, php-format
msgid "Not attempted after the error in %s."
msgstr "Не виконувалося через помилку в %s."

#. translators: %1$d: parent post ID, %2$s: language code
#: includes/class-aipt-auto-run.php:149
#, php-format
msgid "The parent #%1$d has no %2$s translation yet."
msgstr "У батьківського запису #%1$d ще немає перекладу мовою %2$s."

#. translators: %s: list of taxonomy:term ID pairs
#: includes/class-aipt-auto-run.php:170
#, php-format
msgid "Terms without a translation: %s"
msgstr "Терміни без перекладу: %s"

#: includes/class-aipt-auto-status.php:139
msgid "The translation did not finish."
msgstr "Переклад не було завершено."

#. translators: %s: error message
#: includes/class-aipt-auto-status.php:187
#: includes/class-aipt-auto-status.php:268
#, php-format
msgid "Automatic translation failed: %s"
msgstr "Автоматичний переклад не вдався: %s"

#. translators: %s: time
#: includes/class-aipt-auto-status.php:232
#, php-format
msgid ""
"Automatic translation stopped before this language (no progress since %s)"
msgstr "Автоматичний переклад зупинився до цієї мови (немає прогресу з %s)"

#: includes/class-aipt-auto-status.php:233
msgid "Waiting: automatic translation of the other languages is running"
msgstr "Очікування: триває автоматичний переклад іншими мовами"

#. translators: %s: time the event was due
#: includes/class-aipt-auto-status.php:237
#, php-format
msgid "Automatic translation did not run (the scheduled event for %s is gone)"
msgstr ""
"Автоматичний переклад не запускався (запланована на %s подія зникла з черги)"

#. translators: %s: time the event was due
#: includes/class-aipt-auto-status.php:241
#, php-format
msgid ""
"Automatic translation was due at %s and has not run yet — is WP-Cron "
"running? (see README: server cron)"
msgstr ""
"Автоматичний переклад мав запуститися о %s, але ще не запускався — чи працює "
"WP-Cron? (див. README: серверний cron)"

#. translators: %s: time
#: includes/class-aipt-auto-status.php:244
#, php-format
msgid "Automatic translation is scheduled for %s"
msgstr "Автоматичний переклад заплановано на %s"

#. translators: %d: retry number
#: includes/class-aipt-auto-status.php:247
#, php-format
msgid "(retry %d)"
msgstr "(повтор %d)"

#. translators: %s: time
#: includes/class-aipt-auto-status.php:253
#, php-format
msgid "Automatic translation started at %s and did not finish"
msgstr "Автоматичний переклад розпочався о %s і не завершився"

#. translators: %s: time
#: includes/class-aipt-auto-status.php:255
#, php-format
msgid "Automatic translation is running since %s"
msgstr "Автоматичний переклад виконується з %s"

#: includes/class-aipt-auto-status.php:258
msgid "A translation already existed (not updated)"
msgstr "Переклад уже існував (не оновлено)"

#. translators: %1$s: time, %2$s: warning message
#: includes/class-aipt-auto-status.php:262
#, php-format
msgid "Translated automatically at %1$s, with a warning: %2$s"
msgstr "Перекладено автоматично о %1$s, з попередженням: %2$s"

#. translators: %s: time
#: includes/class-aipt-auto-status.php:265
#, php-format
msgid "Translated automatically at %s"
msgstr "Перекладено автоматично о %s"

#. translators: %s: reason
#: includes/class-aipt-auto-status.php:271
#, php-format
msgid "Automatic translation skipped: %s"
msgstr "Автоматичний переклад пропущено: %s"

#: includes/class-aipt-auto.php:109 includes/class-aipt-bulk-request.php:26
#: includes/class-aipt-metabox.php:181
msgid "AI Translator is disabled in Settings."
msgstr "AI Перекладач вимкнено в налаштуваннях."

#. translators: %s: error message
#: includes/class-aipt-auto.php:151
#, php-format
msgid "could not schedule the WP-Cron event: %s"
msgstr "не вдалося запланувати подію WP-Cron: %s"

#: includes/class-aipt-auto.php:170
msgid "Could not schedule the WP-Cron event."
msgstr "Не вдалося запланувати подію WP-Cron."

#: includes/class-aipt-auto.php:192
msgid ""
"Automatic translation of this post is scheduled, running or done. Reload the "
"post to see its status."
msgstr ""
"Автоматичний переклад цього запису заплановано, виконується або завершено. "
"Перезавантажте запис, щоб побачити статус."

#: includes/class-aipt-auto.php:204
msgid ""
"Only published posts of an enabled post type in the default language are "
"translated automatically."
msgstr ""
"Автоматично перекладаються лише опубліковані записи ввімкненого типу мовою "
"за замовчуванням."

#. translators: 1: translation post ID, 2: number of content parts
#: includes/class-aipt-blocks.php:164
#, php-format
msgid ""
"Translation #%1$d was saved and left as a draft: some content parts (%2$d) "
"kept the original text because their block markup could not be protected or "
"came back changed. Translate the post again or edit those parts manually."
msgstr ""
"Переклад #%1$d збережено й залишено чернеткою: частина вмісту (%2$d фрагм.) "
"залишилася мовою оригіналу, бо розмітку блоків не вдалося захистити або вона "
"повернулася зміненою. Перекладіть запис заново або виправте ці фрагменти "
"вручну."

#. translators: 1: translation post ID, 2: number of content parts
#: includes/class-aipt-blocks.php:166
#, php-format
msgid ""
"Translation #%1$d was saved, but some content parts (%2$d) kept the original "
"text because their block markup could not be protected or came back changed. "
"Translate the post again or edit those parts manually."
msgstr ""
"Переклад #%1$d збережено, але частина вмісту (%2$d фрагм.) залишилася мовою "
"оригіналу, бо розмітку блоків не вдалося захистити або вона повернулася "
"зміненою. Перекладіть запис заново або виправте ці фрагменти вручну."

#: includes/class-aipt-bulk-ajax.php:54 includes/class-aipt-job-builder.php:34
#: includes/class-aipt-runner.php:223
msgid "This post type is not enabled in the translation settings."
msgstr "Цей тип запису не ввімкнено в налаштуваннях перекладу."

#: includes/class-aipt-bulk-ajax.php:58 includes/class-aipt-runner.php:204
msgid "Insufficient permissions to publish the translation."
msgstr "Недостатньо прав для публікації перекладу."

#: includes/class-aipt-bulk-ajax.php:66
msgid "Select at least one post type or taxonomy."
msgstr "Виберіть принаймні один тип записів або таксономію."

#: includes/class-aipt-bulk-ajax.php:290
#: includes/class-aipt-bulk-request.php:125 includes/class-aipt-finalize.php:52
#: includes/class-aipt-metabox.php:191 includes/class-aipt-metabox.php:195
#: includes/class-aipt-pipeline.php:96
msgid "Translation job not found or expired. Start over."
msgstr "Завдання перекладу не знайдено або застаріло. Почніть заново."

#: includes/class-aipt-bulk-jobs.php:96
msgid ""
"This record is being prepared by another request. Try again in a few seconds."
msgstr "Цей запис зараз готує інший запит. Спробуйте за кілька секунд."

#: includes/class-aipt-bulk-jobs.php:119
msgid ""
"An unfinished job of this record was started by another user or under "
"another multilingual plugin."
msgstr ""
"Незавершене завдання цього запису запущене іншим користувачем або з іншим "
"мультимовним плагіном."

#: includes/class-aipt-bulk-jobs.php:127
msgid ""
"An unfinished job of this record was prepared with other options (mode, "
"publishing or dates)."
msgstr ""
"Незавершене завдання цього запису підготовлено з іншими параметрами (режим, "
"публікація або дати)."

#: includes/class-aipt-bulk-jobs.php:152
msgid "Could not save the bulk job reference. Try again."
msgstr ""
"Не вдалося зберегти посилання на завдання масового перекладу. Спробуйте ще "
"раз."

#: includes/class-aipt-bulk-jobs.php:178
msgid ""
"The translation of this record changed after its unfinished job was prepared "
"(it was translated or removed elsewhere). Check the translation, then "
"discard the job."
msgstr ""
"Переклад цього запису змінився після підготовки його незавершеного завдання "
"(його створили або видалили в іншому місці). Перевірте переклад, потім "
"видаліть завдання."

#: includes/class-aipt-bulk-jobs.php:304 includes/class-aipt-finalize.php:97
#: includes/class-aipt-pipeline.php:383
msgid "The translation is already being saved. Try again in a few seconds."
msgstr "Переклад уже зберігається. Повторіть запит за кілька секунд."

#: includes/class-aipt-bulk-jobs.php:307
msgid ""
"A block of this job is being translated right now. Try again in a minute."
msgstr "Блок цього завдання зараз перекладається. Спробуйте за хвилину."

#: includes/class-aipt-bulk-page.php:25 includes/class-aipt-bulk-page.php:159
msgid "Bulk translation"
msgstr "Масовий переклад"

#: includes/class-aipt-bulk-page.php:26
msgid "AI Bulk Translation"
msgstr "AI масовий переклад"

#: includes/class-aipt-bulk-page.php:58
msgid "Collecting records…"
msgstr "Збір записів…"

#. translators: %1$d: records estimated so far, %2$d: total records
#: includes/class-aipt-bulk-page.php:60
#, php-format
msgid "Estimating… %1$d of %2$d"
msgstr "Оцінка… %1$d з %2$d"

#: includes/class-aipt-bulk-page.php:61 includes/class-aipt-bulk-page.php:248
#: includes/class-aipt-bulk-page.php:332
msgid "Estimate"
msgstr "Оцінка"

#: includes/class-aipt-bulk-page.php:62
msgid "Terms"
msgstr "Терміни"

#: includes/class-aipt-bulk-page.php:63
msgid "Posts"
msgstr "Записи"

#: includes/class-aipt-bulk-page.php:64
msgid "Total"
msgstr "Разом"

#: includes/class-aipt-bulk-page.php:65
msgid "Characters"
msgstr "Символів"

#: includes/class-aipt-bulk-page.php:66
msgid "Estimated cost"
msgstr "Орієнтовна вартість"

#: includes/class-aipt-bulk-page.php:67
msgid "Running…"
msgstr "Виконується…"

#: includes/class-aipt-bulk-page.php:68
msgid "Stopping: waiting for the requests in progress…"
msgstr "Зупинка: очікування запитів, що виконуються…"

#: includes/class-aipt-bulk-page.php:69
msgid ""
"Stopped. Press Start to continue; finished records are skipped and "
"unfinished ones resume."
msgstr ""
"Зупинено. Натисніть «Старт», щоб продовжити: готові записи буде пропущено, "
"незавершені продовжаться."

#: includes/class-aipt-bulk-page.php:70
msgid "Finished."
msgstr "Готово."

#: includes/class-aipt-bulk-page.php:71
msgid ""
"Stopped after 5 errors in a row. Check the log, then press Start to continue."
msgstr ""
"Зупинено після 5 помилок поспіль. Перевірте журнал, потім натисніть «Старт», "
"щоб продовжити."

#: includes/class-aipt-bulk-page.php:72
msgid ""
"The API key was rejected. Check it in Settings > AI Translator, then press "
"Start to continue."
msgstr ""
"API-ключ відхилено. Перевірте його в «Налаштування > AI Перекладач», потім "
"натисніть «Старт», щоб продовжити."

#: includes/class-aipt-bulk-page.php:73
msgid ""
"Cost limit reached: no new records are started; records whose blocks are all "
"translated are still saved."
msgstr ""
"Досягнуто ліміту витрат: нові записи не запускаються; записи, у яких "
"перекладено всі блоки, все одно зберігаються."

#: includes/class-aipt-bulk-page.php:74
msgid "Confirm that existing translations will be overwritten."
msgstr "Підтвердьте, що наявні переклади буде перезаписано."

#: includes/class-aipt-bulk-page.php:75
msgid "Nothing to translate for this selection."
msgstr "Для цього вибору нічого перекладати."

#. translators: %1$s: taxonomy name, %2$s: language code
#: includes/class-aipt-bulk-page.php:77
#, php-format
msgid "Terms: %1$s → %2$s"
msgstr "Терміни: %1$s → %2$s"

#. translators: %1$d: current block number, %2$d: total number of blocks
#: includes/class-aipt-bulk-page.php:79
#, php-format
msgid "block %1$d of %2$d"
msgstr "блок %1$d з %2$d"

#: includes/class-aipt-bulk-page.php:80
msgid "preparing"
msgstr "підготовка"

#: includes/class-aipt-bulk-page.php:81
msgid "saving"
msgstr "збереження"

#: includes/class-aipt-bulk-page.php:82
msgid "retrying"
msgstr "повтор"

#: includes/class-aipt-bulk-page.php:83
msgid "Network error"
msgstr "Помилка мережі"

#: includes/class-aipt-bulk-page.php:84
msgid "Interrupted: the record resumes on the next Start."
msgstr "Перервано: запис продовжиться під час наступного запуску."

#: includes/class-aipt-bulk-page.php:85
msgid "translation"
msgstr "переклад"

#: includes/class-aipt-bulk-page.php:86
msgid "Translate anyway"
msgstr "Все одно перекласти"

#: includes/class-aipt-bulk-page.php:87
msgid "Discard"
msgstr "Видалити"

#: includes/class-aipt-bulk-page.php:88
msgid ""
"Discard this job? Blocks already translated for it will be paid again if the "
"record is translated later."
msgstr ""
"Видалити це завдання? Уже перекладені блоки буде оплачено повторно, якщо "
"запис перекладуть пізніше."

#: includes/class-aipt-bulk-page.php:89
msgid "Nothing needs a manual check."
msgstr "Ручна перевірка не потрібна."

#: includes/class-aipt-bulk-page.php:90
msgid "Wait until the current run has stopped."
msgstr "Дочекайтеся зупинки поточного запуску."

#. translators: %1$d: blocks translated, %2$d: total number of blocks
#: includes/class-aipt-bulk-page.php:92
#, php-format
msgid "unfinished, resumes on the next Start (%1$d of %2$d blocks translated)"
msgstr ""
"не завершено, продовжиться під час наступного запуску (перекладено блоків: "
"%1$d з %2$d)"

#: includes/class-aipt-bulk-page.php:93
msgid "writing was interrupted: check the translation"
msgstr "запис перервався: перевірте переклад"

#. translators: %s: outcome, e.g. "created"
#: includes/class-aipt-bulk-page.php:95
#, php-format
msgid "finished: %s"
msgstr "завершено: %s"

#: includes/class-aipt-bulk-page.php:96
msgid "the translation changed elsewhere: check it, then discard the job"
msgstr ""
"переклад змінено в іншому місці: перевірте його, потім видаліть завдання"

#: includes/class-aipt-bulk-page.php:97
msgid "Continuing the current run: records finished in it are skipped."
msgstr "Продовження поточного запуску: готові в ньому записи пропускаються."

#: includes/class-aipt-bulk-page.php:98
msgid ""
"Forget the current run? The next Start begins a new run: in safe or "
"overwrite mode, records finished in this run are translated again."
msgstr ""
"Забути поточний запуск? Наступний «Старт» почне новий запуск: у безпечному "
"режимі та режимі перезапису готові в цьому запуску записи буде перекладено "
"знову."

#: includes/class-aipt-bulk-page.php:99
msgid ""
"Discard this job and translate the record again in overwrite mode? Its "
"translation, if any, is replaced and the blocks are paid again."
msgstr ""
"Видалити це завдання й перекласти запис заново в режимі перезапису? Наявний "
"переклад буде замінено, а блоки оплачено повторно."

#. translators: %d: number of terms still to translate
#: includes/class-aipt-bulk-page.php:101
#, php-format
msgid "%d terms left"
msgstr "залишилося термінів: %d"

#. translators: %s: error message
#: includes/class-aipt-bulk-page.php:103
#, php-format
msgid "Stopped: %s"
msgstr "Зупинено: %s"

#. translators: %s: user display name
#: includes/class-aipt-bulk-page.php:105
#, php-format
msgid "started by %s"
msgstr "запущено: %s"

#: includes/class-aipt-bulk-page.php:108
msgid "created"
msgstr "створено"

#: includes/class-aipt-bulk-page.php:109
msgid "created with a warning"
msgstr "створено з попередженням"

#: includes/class-aipt-bulk-page.php:110
msgid "updated"
msgstr "оновлено"

#: includes/class-aipt-bulk-page.php:111
msgid "updated with a warning"
msgstr "оновлено з попередженням"

#: includes/class-aipt-bulk-page.php:112
msgid "linked to an existing term"
msgstr "пов’язано з наявним терміном"

#: includes/class-aipt-bulk-page.php:113
msgid "would create"
msgstr "буде створено"

#: includes/class-aipt-bulk-page.php:114
msgid "would update"
msgstr "буде оновлено"

#: includes/class-aipt-bulk-page.php:115
msgid "already translated"
msgstr "уже перекладено"

#: includes/class-aipt-bulk-page.php:116
msgid "finished earlier in this run"
msgstr "уже готово в цьому запуску"

#: includes/class-aipt-bulk-page.php:117
msgid "translation in progress in the multilingual plugin"
msgstr "переклад виконується в мультимовному плагіні"

#: includes/class-aipt-bulk-page.php:118
msgid "being translated elsewhere"
msgstr "перекладається в іншому місці"

#: includes/class-aipt-bulk-page.php:119
msgid "parent not translated"
msgstr "батьківський запис не перекладено"

#: includes/class-aipt-bulk-page.php:120
msgid "terms not translated"
msgstr "терміни не перекладено"

#: includes/class-aipt-bulk-page.php:121
msgid "no permission"
msgstr "немає прав"

#: includes/class-aipt-bulk-page.php:122
