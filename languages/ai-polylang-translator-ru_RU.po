msgstr "Получите ключ в <a href=\"https://vercel.com/ai-gateway\" target=\"_blank\" rel=\"noopener\">Vercel AI Gateway</a>. Успешная проверка сохранит введённый ключ."

#: includes/class-aipt-settings.php:204 includes/class-aipt-settings.php:313
msgid "Model"
msgstr "Модель"

#: includes/class-aipt-settings.php:217
msgid "Advanced settings"
msgstr "Расширенные настройки"

#: includes/class-aipt-settings.php:221
msgid "Post types"
msgstr "Типы записей"

#: includes/class-aipt-settings.php:233
msgid "The translation metabox will only appear on the selected post types."
msgstr "Метабокс перевода появится только у выбранных типов."

#: includes/class-aipt-settings.php:237
msgid "Site context for the translator"
msgstr "Контекст сайта для переводчика"

#: includes/class-aipt-settings.php:240
msgid "E.g.: furniture online store — friendly tone, keep brand names untranslated"
msgstr "Например: интернет-магазин мебели — дружелюбный тон, названия брендов не переводить"

#: includes/class-aipt-settings.php:241
msgid "Appended to the prompt — helps the model maintain topic and tone."
msgstr "Добавляется в промпт — помогает модели выдерживать тематику и тон."

#: includes/class-aipt-settings.php:246
msgid "Yoast SEO"
msgstr "Yoast SEO"

#: includes/class-aipt-settings.php:250
msgid "Translate SEO title, description and focus keyphrase"
msgstr "Переводить SEO-заголовок, описание и фокусное слово"

#: includes/class-aipt-settings.php:256
msgid "Request timeout (seconds)"
msgstr "Таймаут запроса, сек"

#: includes/class-aipt-settings.php:261
msgid "ACF fields to translate"
msgstr "Переводимые поля ACF"

#: includes/class-aipt-settings.php:306
msgid "Choose whether each text field is translated, copied as-is, or left untouched. Other field types (images, numbers, relationships, etc.) are copied as-is."
msgstr "Выберите для каждого текстового поля: переводить, копировать как есть или не трогать. Остальные типы полей (изображения, числа, связи и т. д.) копируются как есть."

#: includes/class-aipt-settings.php:271
msgid "Save settings"
msgstr "Сохранить настройки"

#: includes/class-aipt-settings.php:276
msgid "Translation costs"
msgstr "Расходы на перевод"

#: includes/class-aipt-settings.php:291
msgid "Total spent"
msgstr "Всего потрачено"

#: includes/class-aipt-settings.php:295
msgid "Spent today"
msgstr "Потрачено сегодня"

#: includes/class-aipt-settings.php:299
msgid "Translations"
msgstr "Переводов"

#: includes/class-aipt-settings.php:305
msgid "No translations yet. Costs will appear here after the first translation."
msgstr "Переводов пока нет. Расходы появятся здесь после первого перевода."

