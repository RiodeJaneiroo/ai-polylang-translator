msgstr "Пропускати (перекладати лише відсутнє)"

#: includes/class-aipt-bulk-page.php:216
msgid "Update in safe mode (filled fields are kept)"
msgstr "Оновлювати в безпечному режимі (заповнені поля зберігаються)"

#: includes/class-aipt-bulk-page.php:217
msgid "Overwrite"
msgstr "Перезаписати"

#: includes/class-aipt-bulk-page.php:218
msgid ""
